# Local-only example. Copy to .env; never commit real credentials.
APP_ENV=local
APP_GIT_SHA=local
MONGO_URL=mongodb://127.0.0.1:27017
DB_NAME=theharvesttheory_local
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
PUBLIC_FRONTEND_URL=http://localhost:3000
NOTIFICATION_MODE=fake
BOT_MODE=fake
LOCAL_PROVIDER_BASE_URL=http://127.0.0.1:8301
WORKER_ENABLED=true
RESEND_API_KEY=
EMAIL_FROM_NAME=The Harvest Theory
SENDER_EMAIL=harvest@example.test
NOTIFY_EMAILS=team@example.test
SUPPORT_EMAIL=team@example.test
SLACK_WEBHOOK_URL=
NEWSLETTER_SIGNING_KEY=local-only-newsletter-key-do-not-use-in-production
RATE_LIMIT_HMAC_KEY=local-only-rate-key-do-not-use-in-production
TURNSTILE_SECRET_KEY=
TURNSTILE_HOSTNAMES=localhost,127.0.0.1
TRUSTED_PROXY_CIDRS=
IP_RATE_LIMIT=10
GLOBAL_RATE_LIMIT=300
